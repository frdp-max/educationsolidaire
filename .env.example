# ==============================================================================
# UNISSON — Association Éducation Solidaire
# Variables d'Environnement (Exemple de configuration)
# ==============================================================================

# Port d'écoute du serveur Node.js
PORT=3000
NODE_ENV=production
PUBLIC_URL=https://education-solidaire.org

# Configuration HelloAsso v5 API (OAuth2 Client Credentials)
# Mode: 'sandbox' pour les tests, 'production' pour l'encaissement réel
HELLOASSO_ENV=sandbox
HELLOASSO_CLIENT_ID=VOTRE_CLIENT_ID_HELLOASSO
HELLOASSO_CLIENT_SECRET=VOTRE_CLIENT_SECRET_HELLOASSO
HELLOASSO_ORGANIZATION_SLUG=unisson-association-education-solidaire

# Authentification des notifications (webhooks) HelloAsso — renseigner UNE des deux options :
# - Association : secret ajouté à l'URL déclarée chez HelloAsso
#   https://education-solidaire.org/api/helloasso/webhook?secret=<valeur>   (générer : openssl rand -hex 32)
HELLOASSO_WEBHOOK_SECRET=
# - Compte partenaire HelloAsso uniquement : clé de signature HMAC (en-tête x-ha-signature)
# HELLOASSO_WEBHOOK_SIGNATURE_KEY=

# URL de repli si clés non renseignées
HELLOASSO_DEFAULT_FORM_URL=https://www.helloasso.com/associations/unisson-association-education-solidaire

# Clé de sécurisation pour la consultation des alertes d'urgence (/api/emergency/alerts)
# Obligatoire (16 caractères minimum), transmise uniquement via l'en-tête X-Admin-Key.
# Générer une clé : openssl rand -hex 32
ADMIN_SECRET_KEY=

# Notifications d'urgence par email (Brevo — API transactionnelle)
# Clé API : Brevo > SMTP & API > Clés API. L'expéditeur doit être validé dans Brevo (domaine authentifié).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=alertes@education-solidaire.org
BREVO_SENDER_NAME=UNISSON — Alertes urgence
# Destinataires de l'astreinte, séparés par des virgules
EMERGENCY_NOTIFY_EMAILS=contact@education-solidaire.org

# Webhook optionnel pour notifier l'astreinte sur Discord / Slack / Passerelle SMS
# EMERGENCY_WEBHOOK_URL=https://discord.com/api/webhooks/...
